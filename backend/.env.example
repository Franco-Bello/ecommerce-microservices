# ==========================================
# PUERTOS DE SERVICIOS
# ==========================================
PORT_API_GATEWAY=3000
PORT_USERS_MS=3001
PORT_PRODUCTS_MS=3002
PORT_INVOICES_MS=3003

# HOST TCP PARA MICROSERVICIOS
MS_TCP_HOST=127.0.0.1

# ==========================================
# BASES DE DATOS (DOCKER / LOCAL)
# ==========================================

# PostgreSQL - Users Microservice (Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=users_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/users_db?schema=public"

# MySQL - Products Microservice (TypeORM)
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=user_products
MYSQL_PASSWORD=password_products
MYSQL_DATABASE=products_db
MYSQL_PORT=3306

# MongoDB - Invoices Microservice (TypeORM / Mongoose)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpassword
MONGO_DATABASE=invoices_db
MONGO_PORT=27017
MONGO_URI="mongodb://root:rootpassword@localhost:27017/invoices_db?authSource=admin"

# ==========================================
# SEGURIDAD Y JWT
# ==========================================
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRES_IN=1d